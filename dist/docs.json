        "signature": "() => Promise<{ message: string; }>",
        "parameters": [],
        "returns": "Promise<{ message: string; }>",
        "tags": [],
        "docs": "Stops watching the area and forgets the saved endpoint, user ID and token.",
        "complexTypes": [],
        "slug": "stoptrackuser"
      }
